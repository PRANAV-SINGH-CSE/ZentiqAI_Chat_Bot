# ==========================================
# Core Configuration
# ==========================================
AUTH_TOKEN=my-secret-key
API_BASE_URL=http://localhost:8080
USE_FIREBASE=true
OLLAMA_TEXT_MODEL=my-custom-model:latest
OLLAMA_IMAGE_MODEL=llava:13b
GUEST_OLLAMA_TEXT_MODEL=qwen2.5-coder:7b-instruct
OLLAMA_NUM_PREDICT=2200
OLLAMA_NUM_CTX=2048
OLLAMA_TIMEOUT_SECONDS=500

# ==========================================
# Gemini API Configuration
# ==========================================
# Add your Gemini API keys from: https://ai.google.dev/
# You can add up to 3 keys for automatic rotation on errors
# If a key hits quota or has auth issues, system automatically switches to the next key

GEMINI_API_KEY_1=your_first_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key

# Gemini Model (use 'gemini-1.5-flash' for speed or 'gemini-1.5-pro' for better quality)
GEMINI_MODEL=gemini-2.5-flash

# Custom image analysis prompt (optional)
# This prompt is combined with the user's question when analyzing images
IMAGE_ANALYSIS_PROMPT=You are ZentiqAI, analyzing this image. Be detailed, insightful, and maintain your calm, confident personality. Describe what you see and provide any relevant context or analysis.

# ==========================================
# Firebase Configuration (Optional)
# ==========================================
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
